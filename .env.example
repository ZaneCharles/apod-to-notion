# 复制这个文件，改名为 .env，再把下面的值换成你自己的
# （.env 里是密钥，千万不要上传到 GitHub！.gitignore 已经帮你排除了）
NASA_API_KEY=你的NASA key
NOTION_TOKEN=ntn_你的Notion集成密钥
NOTION_DATABASE_ID=你的Notion数据库ID
LLM_API_KEY=sk-你的DeepSeek key

# 以下可选：换成别家模型时才需要改
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi：    LLM_BASE_URL=https://api.moonshot.cn/v1
# CLASSIFY=0   ← 不想让 AI 自动填分类就取消这行注释
